  const decStats = { readbacks: 0, tokens: 0, reset() { decStats.readbacks = 0; decStats.tokens = 0; } };

  // ── CORE ring decode over ALREADY-FRAMED ids: yields each committed (non-EOS) token id one at a time.
  //    Both the messages-based generate() and the ids-based generateIds() (the app bridge's entry) consume
  //    this — one loop, no duplication. `signal` (AbortSignal) stops cleanly between committed tokens. ──
  async function* ringDecodeIds(ids, maxNew, signal) {
    ensureDEC();
    if (ids.length >= MAXCTX) throw new Error(`ctx overflow: ${ids.length} >= ${MAXCTX}`);
    maxNew = Math.max(0, Math.min(maxNew, MAXCTX - ids.length));
    const state = newState();
    const L0 = ids.length;
    dev.queue.writeBuffer(DEC.ring, 0, new Uint32Array(ids));
    decStats.reset();
    const setRope = (slot, pos) => { dev.queue.writeBuffer(slot.cos, 0, rope.cos[pos]); dev.queue.writeBuffer(slot.sin, 0, rope.sin[pos]); };
    try {
      // PREFILL: forward ids[0..L0-2] (all but the last) to build KV/SSM state — no argmax. The last prompt
      // token is forwarded by the FIRST decode step (so it is forwarded exactly once — the recurrence must
      // not double-advance). Batched, bounded queue depth (prefill is one-time, not per-token latency).
      for (let off = 0, par = 0; off < L0 - 1; off += BATCH, par ^= 1) {
        const n = Math.min(BATCH, (L0 - 1) - off);
        const enc = dev.createCommandEncoder();
        for (let k = 0; k < n; k++) { const pos = off + k, slot = DEC.rope[par * BATCH + k]; setRope(slot, pos); recForward(enc, pos, state, slot); }
        passBreak(); dev.queue.submit([enc.finish()]);
        await dev.queue.onSubmittedWorkDone();
      }
      // DECODE: step j forwards ring[L0-1+j] @ pos (L0-1+j) → append ring[L0+j]; output token = ring[L0+j].
      // Two batches kept in flight: batch N+1 is encoded+submitted before batch N's fence is read.
      const submitBatch = (n, jStart, par) => {
        const enc = dev.createCommandEncoder();
