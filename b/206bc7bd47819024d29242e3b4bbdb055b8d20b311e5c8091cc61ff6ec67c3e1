  return { D, tok, step, newState, generate, generateIds, chat, frame, EOS, layers, BATCH, _read, _write, _stepLayer, _matvec, _stepErr, _perf: perf, _decStats: decStats, _B: B, _dev: dev, _mv: mv, _passBreak: passBreak, _wF: wF, _sb: sb, info: () => ({ arch: "qwen35", model: "bonsai-27b", layers: D.n_layer, resident: true, quant: "q1" }) };
}

