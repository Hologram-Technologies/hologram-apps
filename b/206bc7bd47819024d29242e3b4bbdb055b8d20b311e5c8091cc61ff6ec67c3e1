  function recArgmaxAppend(enc, pos) {
    d(enc, P.rms1p, [B.h, outNorm, B.norm, uF([dm, D.eps])], 1);
    mv(enc, lmHead, B.norm, B.logits);
    d(enc, P.argmax, [B.logits, B.argIdx, uU([vocab])], 1);
