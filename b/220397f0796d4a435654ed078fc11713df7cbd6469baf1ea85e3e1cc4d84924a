        background: radial-gradient(120% 95% at 16% 0%, color-mix(in srgb, var(--ta, transparent) 28%, transparent), transparent 55%),
                    linear-gradient(0deg, var(--bg) 4%, rgba(11,13,16,0.2) 55%, rgba(11,13,16,0.55)); }
      #detail { --ta: var(--acc); }   /* per-title accent, set from the poster's dominant colour */
      #detail .det-logo { filter: drop-shadow(0 4px 18px color-mix(in srgb, var(--ta) 45%, #000)); }
      #detail .btn.primary { background: var(--ta); }
      .back { position: absolute; top: var(--s4); left: var(--s5); z-index: 5; }   /* share the content left-gutter */
      .det-body { position: relative; margin-top: -8rem; padding: 0 var(--s5); z-index: 3; max-width: 64rem; }
      .det-body h1 { font-size: var(--t4); font-weight: 800; letter-spacing: -0.02em; margin: 0 0 var(--s2); line-height: 1.05; }
      .det-logo { max-width: min(26rem, 70%); max-height: 8rem; object-fit: contain; object-position: left bottom; margin: 0 0 var(--s3); filter: drop-shadow(0 4px 14px rgba(0,0,0,0.6)); }
      .det-meta .pill.cert { color: var(--ink); border-color: #4b5263; font-weight: 700; }
      /* keyword chips */
      .kw { display: flex; flex-wrap: wrap; gap: var(--s1); margin: 0 0 var(--s4); }
      .kw .chip { background: var(--chip); border: 1px solid var(--line); border-radius: 999px; padding: 0.2rem var(--s3); font-size: var(--t1); color: var(--dim); }
      /* cast row */
      #dCast .strip { gap: var(--s3); }
      .cast-c { width: 8.5rem; flex: 0 0 auto; text-align: center; }
      .cast-c .face { width: 8.5rem; height: 8.5rem; border-radius: 50%; object-fit: cover; background: linear-gradient(135deg, #2c3548, #141a26); display: block; overflow: hidden; position: relative; }
      .cast-c .face .bgimg { opacity: 0; transition: opacity 0.4s ease; } .cast-c .face .bgimg.in { opacity: 1; }
      .cast-c .face.ph { display: flex; align-items: center; justify-content: center; font-size: var(--t4); font-weight: 800; color: rgba(255,255,255,0.82); background: linear-gradient(135deg, #2c3548, #141a26); box-shadow: inset 0 0 0 1px rgba(255,255,255,0.06); }
      .cast-c .nm { margin-top: var(--s2); font-weight: 600; font-size: var(--t1); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .cast-c .ch { color: var(--dim); font-size: var(--t1); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .det-meta { display: flex; align-items: center; gap: var(--s2); flex-wrap: wrap; color: var(--dim); font-size: var(--t1); margin-bottom: var(--s3); }
      /* Dot separators between the plain metadata bits (year - runtime - genres - rating - director); pills stay clean. */
      .det-meta > span:not([class]) + span:not([class])::before { content: "·"; margin-right: var(--s2); opacity: 0.55; }
      .det-meta .pill { padding: 0.1rem 0.6rem; border: 1px solid var(--line); border-radius: 999px; }
      .det-meta .pill.k { color: #7ee787; border-color: #2a4; } .det-meta .pill.stream { color: #79c0ff; }
      .det-meta .pill.air { color: #7ee787; border-color: #2a4; } .det-meta .pill.ended { color: var(--muted); }
      .ep-air { font-size: var(--t0); color: var(--muted); white-space: nowrap; align-self: center; margin-left: 0.5rem; }
      .det-meta .verify { color: var(--dim); } .det-meta .verify.ok { color: #7ee787; } .det-meta .verify.bad { color: #ff8a80; }
      .det-body p.ov { font-size: var(--t2); line-height: 1.55; color: #d6dde4; max-width: 42rem; margin: 0 0 var(--s4); }
      .det-body p.prov { font: var(--t1)/1.5 ui-monospace, Menlo, Consolas, monospace; color: var(--dim); margin: calc(-1 * var(--s3)) 0 var(--s4); word-break: break-word; }
      .det-body p.prov a { color: var(--acc); } .det-body p.prov b { color: #d2a8ff; }
      .actions { display: flex; align-items: center; gap: var(--s2); flex-wrap: wrap; margin-bottom: var(--s5); }
      .actions .lab { font-size: var(--t1); color: var(--dim); margin-left: 0.2rem; }
      /* Where to watch */
      .where { margin: 0 0 var(--s5); max-width: 46rem; }
      .where-h { font-size: var(--t1); color: var(--dim); margin-bottom: var(--s2); font-weight: 600; }
      .where-row { display: flex; align-items: center; gap: var(--s2); flex-wrap: wrap; margin-bottom: var(--s2); }
      .where-t { font-size: var(--t1); color: var(--dim); min-width: 5.5rem; }
      .prov-chip { display: inline-flex; align-items: center; gap: var(--s1); background: var(--chip); border: 1px solid var(--line); border-radius: 999px; padding: 0.25rem var(--s3); font-size: var(--t1); font-weight: 600; }
      .prov-chip img { width: 1.3rem; height: 1.3rem; border-radius: var(--rad-sm); }
      /* Seasons + episodes */
      .season-bar { display: flex; gap: var(--s2); flex-wrap: wrap; padding: 0 var(--s5) var(--s3); }
      .season-pill { background: var(--chip); border: 1px solid var(--line); border-radius: 999px; padding: 0.3rem var(--s3); font-size: var(--t1); font-weight: 600; color: var(--dim); }
      .season-pill.on { background: var(--ink); color: #06101f; border-color: var(--ink); }
      .eps { display: flex; flex-direction: column; gap: var(--s2); padding: 0 var(--s5); max-width: 64rem; }
      .eps-note { color: var(--dim); font-size: var(--t1); padding: var(--s3) 0; }
      .ep { display: flex; align-items: center; gap: var(--s3); padding: var(--s2); border-radius: var(--rad); cursor: pointer; transition: background 0.15s; }
      .ep:hover { background: var(--panel); }
      .ep-thumb { flex: 0 0 auto; width: 8rem; height: 4.5rem; border-radius: var(--holo-radius-sm, 8px); background: #05070a center/cover no-repeat; display: flex; align-items: center; justify-content: center; font-weight: 800; color: #c9d1d9; }
      .ep-body { flex: 1; min-width: 0; }
      .ep-t { font-weight: 600; font-size: var(--t1); }
      .ep-ov { color: var(--dim); font-size: var(--t1); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .ep-dur { color: var(--dim); font-size: var(--t1); }

      /* ── Player ─────────────────────────────────────────────────────────────── */
      #player { background: #000; }
      #player iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
      #player::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 7rem; z-index: 5; pointer-events: none; background: linear-gradient(180deg, rgba(0,0,0,0.55), transparent); transition: opacity 0.4s ease; }
      #player.dim::before { opacity: 0; }
      /* full-bleed: the app sidebar melts away while watching → the video is the whole screen */
      body.playing #top { display: none; }
      body.playing main { width: 100%; }
      /* the player-top secondary actions become clean round icon buttons (YouTube-minimal) */
      .player-top span .btn { width: 2.7rem; height: 2.7rem; padding: 0; border-radius: 50%; justify-content: center; }
      .player-top span .btn .icon { width: 1.35rem; height: 1.35rem; }
      #player .back { background: rgba(2,6,12,0.6); backdrop-filter: blur(8px); }
      /* Ambient feedback — centered at top so it never collides with Back (left) or CC/Watch-party (right). */
      .enhud { position: absolute; top: var(--s4); left: 50%; transform: translateX(-50%); z-index: 6; display: inline-flex; align-items: center; gap: var(--s2);
        background: rgba(2,6,12,0.62); backdrop-filter: blur(10px); border: 1px solid var(--line); border-radius: 999px;
        padding: var(--s1) var(--s3); font-size: var(--t1); font-weight: 700; color: var(--ink); transition: opacity 0.6s; white-space: nowrap; }
      .enhud .spark { color: #d2a8ff; }
      .enhud.dim { opacity: 0; }
      /* Skip Intro / Credits — bottom-right pill over the player */
      .skipbtn { position: absolute; right: var(--s4); bottom: var(--s5); z-index: 7; display: none; align-items: center; gap: var(--s1);
        background: rgba(8,10,13,0.82); backdrop-filter: blur(8px); border: 1px solid #ffffff44; color: var(--ink); border-radius: var(--rad);
        padding: var(--s2) var(--s4); font-weight: 700; font-size: var(--t1); cursor: pointer; animation: skip-in 0.25s ease; }
      .skipbtn.show { display: inline-flex; } .skipbtn:hover { background: var(--ink); color: #06101f; }
      @keyframes skip-in { from { opacity: 0; transform: translateY(8px); } }
      /* Up Next — card sliding in over the credits */
      .upnext { position: absolute; right: var(--s4); bottom: var(--s5); z-index: 8; width: 26rem; max-width: calc(100vw - 2*var(--s4)); display: none;
        background: rgba(13,17,23,0.96); backdrop-filter: blur(20px); border: 1px solid var(--line); border-radius: var(--rad-lg); overflow: hidden;
        box-shadow: 0 1.5rem 3rem rgba(0,0,0,0.6); animation: wp-in 0.25s ease; }
      .upnext.show { display: block; }
      .upnext .un-head { font-size: var(--t1); color: var(--dim); padding: var(--s3) var(--s3) 0; font-weight: 600; }
      .upnext .un-body { display: flex; gap: var(--s3); padding: var(--s3); }
      .upnext .un-thumb { flex: 0 0 auto; width: 9rem; height: 5.1rem; border-radius: var(--holo-radius-sm, 8px); background: #05070a center/cover no-repeat; }
      .upnext .un-meta { flex: 1; min-width: 0; }
      .upnext .un-t { font-weight: 700; font-size: var(--t1); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .upnext .un-ov { color: var(--dim); font-size: var(--t1); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .upnext .un-cta { display: flex; gap: var(--s2); padding: 0 var(--s3) var(--s3); }
      .upnext .un-play { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: var(--s1); height: var(--s5); border-radius: var(--rad); background: var(--ink); color: #06101f; border: 0; font-weight: 700; cursor: pointer; }
      .upnext .un-x { height: var(--s5); padding: 0 var(--s3); border-radius: var(--rad); background: var(--chip); border: 1px solid var(--line); color: var(--dim); cursor: pointer; }
      /* subtitle selector in the player top bar */
      .ccbtn { pointer-events: auto; background: rgba(2,6,12,0.55); backdrop-filter: blur(8px); }
      .ccbtn.on { background: var(--acc); color: #06101f; }
      /* Watch Together — overlay controls + reaction cameras */
      .player-top { position: absolute; top: 0; left: 0; right: 0; z-index: 6; display: flex; justify-content: space-between; align-items: center; gap: var(--s2); padding: var(--s4); pointer-events: none; }
      .player-top .back { position: static; top: auto; left: auto; }   /* override the global absolute .back so the bar lays out */
      .player-top .ptop-l { display: flex; align-items: center; gap: var(--s3); min-width: 0; }
      .player-top .ptop-title { color: #fff; font-weight: 700; font-size: var(--t2); letter-spacing: 0.01em; text-shadow: 0 1px 8px rgba(0,0,0,0.75); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 46vw; pointer-events: none; }
      @media (max-width: 640px) { .player-top .ptop-title { max-width: 52vw; font-size: var(--t1); } }
      .player-top .btn { pointer-events: auto; background: rgba(2,6,12,0.55); backdrop-filter: blur(8px); }
      /* Theater dissolve — the app chrome fades on idle so it's nothing but the film (video.js hides its own bar). */
      #player .player-top { transition: opacity 0.4s ease, transform 0.4s ease; }
      #player.dim .player-top { opacity: 0; transform: translateY(-10px); pointer-events: none; }
      #player.dim { cursor: none; }
      .watchbtn.on { background: var(--acc); color: #06101f; }
      .watchpanel { position: absolute; top: calc(var(--s4) + var(--s6)); right: var(--s4); z-index: 7; width: 20rem; max-width: calc(100vw - 2 * var(--s4));
        background: rgba(13,17,23,0.97); backdrop-filter: blur(20px) saturate(1.2); border: 1px solid var(--line); border-radius: var(--rad-lg);
        padding: var(--s3); display: flex; flex-direction: column; gap: var(--s3); box-shadow: 0 1.5rem 3rem rgba(0,0,0,0.6); animation: wp-in 0.18s ease; }
      @keyframes wp-in { from { opacity: 0; transform: translateY(-6px); } }
      .wp-head { display: flex; align-items: center; gap: var(--s2); }
      .wp-live { width: 9px; height: 9px; border-radius: 50%; background: #ff5c5c; box-shadow: 0 0 0 0 rgba(255,92,92,0.6); animation: wp-pulse 1.6s infinite; }
      @keyframes wp-pulse { 70% { box-shadow: 0 0 0 7px rgba(255,92,92,0); } 100% { box-shadow: 0 0 0 0 rgba(255,92,92,0); } }
      .wp-title { font-size: var(--t2); font-weight: 700; letter-spacing: -0.01em; }
      .wp-x { margin-left: auto; width: var(--s4); height: var(--s4); border-radius: 50%; background: var(--chip); border: 0; color: var(--dim); font-size: var(--t1); display: inline-flex; align-items: center; justify-content: center; }
      .wp-x:hover { background: var(--chip-hi); color: var(--ink); }
      .wp-who { display: flex; align-items: center; gap: var(--s2); color: var(--dim); font-size: var(--t1); }
      .wp-dots { display: flex; }
      .wp-dots i { width: 1.4rem; height: 1.4rem; border-radius: 50%; margin-left: -0.45rem; border: 2px solid #0d1117; }
      .wp-dots i:first-child { margin-left: 0; }
      .wp-host { color: #06101f; background: var(--acc); border-radius: 999px; padding: 1px 9px; font-size: var(--t0); font-weight: 700; }
      .wp-link { display: flex; gap: var(--s1); }
      .wp-link input { flex: 1; min-width: 0; background: #0b0f14; border: 1px solid var(--line); border-radius: var(--rad); color: var(--dim); font: var(--t1) ui-monospace, Menlo, monospace; padding: 0 var(--s2); height: var(--s5); outline: 0; }
      .wp-link input:focus { border-color: var(--acc); color: var(--ink); }
      .wp-link button { height: var(--s5); padding: 0 var(--s3); border-radius: var(--rad); background: var(--ink); color: #06101f; border: 0; font-weight: 700; }
      .wp-link button:hover { filter: brightness(0.92); }
      .wp-actions { display: flex; gap: var(--s2); }
      .wp-cam { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: var(--s1); height: var(--s5); border-radius: 999px; background: var(--chip); border: 1px solid var(--line); color: var(--ink); font-weight: 600; }
      .wp-cam:hover { background: var(--chip-hi); }
      .wp-cam.on { background: #7ee787; color: #06101f; border-color: #7ee787; }
      .wp-cam .icon { width: 1.15rem; height: 1.15rem; }
      .wp-anywhere { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: var(--s1); height: var(--s5); border-radius: 999px; background: var(--chip); border: 1px solid var(--line); color: var(--ink); font-weight: 600; white-space: nowrap; }
      .wp-anywhere:hover { background: var(--chip-hi); }
      .wp-anywhere.on { background: var(--holo-accent); color: #06101f; border-color: var(--holo-accent); }
      .wp-leave { height: var(--s5); padding: 0 var(--s4); border-radius: 999px; background: transparent; border: 1px solid var(--line); color: #ff8a80; font-weight: 600; }
      .wp-leave:hover { background: rgba(248,81,73,0.14); border-color: #f85149; }
      .camtiles { position: absolute; bottom: var(--s4); left: var(--s4); z-index: 6; display: flex; gap: var(--s2); }
      .camtiles video { width: 9rem; height: 6.75rem; object-fit: cover; border-radius: var(--rad); border: 2px solid var(--acc); background: #000; box-shadow: 0 8px 22px rgba(0,0,0,0.55); }
      .camtiles video.me { border-color: #7ee787; transform: scaleX(-1); }

      /* ── Library ────────────────────────────────────────────────────────────── */
      #library { padding: calc(var(--top-h) + var(--s4)) var(--s5) var(--s6); }
      .lib-bar { display: flex; align-items: center; gap: var(--s2); margin-bottom: var(--s4); flex-wrap: wrap; }
      .lib-bar h2 { font-size: var(--t3); font-weight: 800; margin: 0 var(--s3) 0 0; }
      .lib-toggle { background: var(--chip); color: var(--dim); border: 1px solid var(--line); border-radius: 999px; padding: 0.4rem var(--s3); height: var(--s4); font: inherit; font-weight: 600; cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s; }
      .lib-toggle:hover { color: var(--ink); }
      .lib-toggle.on { background: var(--acc); color: #06101f; border-color: var(--acc); }
      /* Kind segmented control — All · Movies · Shows (the old top-level tabs, folded into one filter). */
      .seg { display: inline-flex; background: rgba(255,255,255,0.06); border-radius: 999px; padding: 0.2rem; gap: 0.15rem; }
      .seg button { background: 0; border: 0; color: var(--dim); font: inherit; font-weight: 600; font-size: var(--t1); padding: 0.3rem 0.9rem; border-radius: 999px; cursor: pointer; transition: color 0.14s, background 0.14s; }
      .seg button:hover { color: var(--ink); }
      .seg button.on { background: var(--ink); color: #06101f; }
      /* ── THE LIBRARY (κ-universe) — mood tiles · decade ribbon · genre chips · endless grid ── */
      .lib-moods { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(9.5rem, 1fr); gap: var(--s2); overflow-x: auto; scrollbar-width: none; margin: 0 0 var(--s3); padding-bottom: 2px; }
      .lib-moods::-webkit-scrollbar { display: none; }
      .mood-tile { position: relative; height: 4.6rem; border: 0; border-radius: var(--rad); color: #fff; font: inherit; font-weight: 800; font-size: var(--t1); letter-spacing: 0.01em; cursor: pointer; overflow: hidden; text-shadow: 0 1px 8px rgba(0,0,0,0.45); transition: transform 0.16s ease, box-shadow 0.16s ease, outline-color 0.16s; outline: 2px solid transparent; outline-offset: 2px; }
      .mood-tile:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 8px 22px rgba(0,0,0,0.35); }
      .mood-tile.on { outline-color: #fff; }
      .mood-tile.on::after { content: "✓"; position: absolute; top: 0.4rem; right: 0.55rem; font-size: var(--t1); opacity: 0.95; }
      .lib-facets { display: flex; align-items: center; gap: var(--s1); flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin: 0 0 var(--s3); padding-bottom: 2px; scroll-snap-type: x proximity; -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 2.2rem), transparent); mask-image: linear-gradient(90deg, #000 calc(100% - 2.2rem), transparent); }
      .lib-facets::-webkit-scrollbar { display: none; }
      .lib-moods { -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 2.2rem), transparent); mask-image: linear-gradient(90deg, #000 calc(100% - 2.2rem), transparent); }
      .fchip { flex: 0 0 auto; background: var(--chip); color: var(--dim); border: 1px solid var(--line); border-radius: 999px; padding: 0.3rem 0.8rem; font: inherit; font-size: var(--t1); font-weight: 600; cursor: pointer; white-space: nowrap; transition: background 0.14s, color 0.14s, border-color 0.14s; }
      .fchip:hover { color: var(--ink); }
      .fchip.on { background: var(--ink); color: #06101f; border-color: var(--ink); }
      .fchip.gem.on { background: linear-gradient(135deg, #f5d576, #b8860b); border-color: transparent; }
      .fchip .mdot { display: inline-block; width: 0.6rem; height: 0.6rem; border-radius: 50%; margin-right: 0.42rem; vertical-align: -1px; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.18); }
      .fchip.mood-chip.on .mdot { box-shadow: inset 0 0 0 1px rgba(0,0,0,0.25); }
      .fsep { width: 1px; height: 1.2rem; background: var(--line); margin: 0 var(--s1); flex: 0 0 auto; }
      .lib-reset { background: 0; border: 0; color: var(--dim); font: inherit; font-size: var(--t1); font-weight: 600; cursor: pointer; padding: 0.3rem 0.5rem; }
      .lib-reset:hover { color: var(--ink); text-decoration: underline; }
      .lib-note { color: var(--dim); padding: var(--s4) 0; font-size: var(--t2); }
      #libMore { height: 1px; }
      select { background: var(--chip); color: var(--ink); border: 1px solid var(--line); border-radius: 999px; padding: 0.4rem var(--s3); font: inherit; height: var(--s4); }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(var(--card-w), 1fr)); gap: var(--s3) var(--s2); }
      .grid .card { width: auto; }

      /* ── Search results ─────────────────────────────────────────────────────── */
      #search { padding: calc(var(--top-h) + var(--s4)) var(--s5) var(--s6); }
      #search h2 { font-size: var(--t2); font-weight: 700; margin: 0 0 var(--s4); color: var(--dim); }
      .empty { color: var(--dim); font-size: var(--t2); padding: var(--s6) 0; text-align: center; }

      /* Settings overlay */
      .settings-back { position: fixed; inset: 0; z-index: 80; background: rgba(2,4,8,0.7); backdrop-filter: blur(6px); display: flex; align-items: center; justify-content: center; padding: var(--s4); }
      .settings-back[hidden] { display: none; }
      .settings-card { width: min(40rem, 100%); max-height: 86vh; overflow-y: auto; background: var(--panel); border: 1px solid var(--line); border-radius: var(--rad-lg); box-shadow: 0 2rem 4rem rgba(0,0,0,0.6); animation: wp-in 0.2s ease; }
      .set-head { display: flex; align-items: center; justify-content: space-between; padding: var(--s4); border-bottom: 1px solid var(--line); font-size: var(--t3); font-weight: 800; }
      /* "Connect streaming" — the single primary action; everything else lives under Advanced. */
      .set-connect { padding: var(--s4); border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: var(--s2);
        background: linear-gradient(180deg, color-mix(in srgb, var(--acc) 12%, transparent), transparent); }
      .set-connect .set-t { font-size: var(--t3); }
      .set-alt { display: flex; gap: var(--s4); flex-wrap: wrap; margin-top: var(--s1); }
