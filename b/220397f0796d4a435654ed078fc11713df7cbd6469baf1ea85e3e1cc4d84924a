<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Discord Activity host: route external stream/art hosts through Discord's URL-mapping proxy.
         Classic + first so it patches fetch/XHR/media-src before any app module runs; no-op off Discord. -->
    <script src="/apps/holo-messenger/holo-discord-proxy.js"></script>
    <title>Holo Player</title>
    <meta name="description" content="Holo Player a content-addressed media library for Hologram OS. Jellyfin-faithful discovery (hero · rails · detail), every title streamed natively through Holo Video and ranked by HoloRank, a transparent on-device recommender. Your media, your way no server, no tracking, rooted in the UOR substrate." />
    <!-- Warm the TLS handshakes to every stream + thumbnail host so Play is instant. -->
    <link rel="preconnect" href="https://test-streams.mux.dev" crossorigin />
    <link rel="preconnect" href="https://dash.akamaized.net" crossorigin />
    <link rel="preconnect" href="https://storage.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://upload.wikimedia.org" crossorigin />
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <link rel="dns-prefetch" href="https://i.ytimg.com" />
    <!-- The hover-preview trailer embed boots from youtube-nocookie + its static JS/CDN hosts; warm them so the
         first hover paints video in a few frames rather than after a cold DNS+TLS round-trip. -->
    <link rel="preconnect" href="https://www.youtube-nocookie.com" crossorigin />
    <link rel="preconnect" href="https://s.ytimg.com" crossorigin />
    <link rel="preconnect" href="https://www.google.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.youtube-nocookie.com" />
    <!-- First-time boot: this app is evicted, so its whole module closure streams from the κ-mirror. Warm that
         host's DNS+TLS now so a new visitor's modules arrive without a cold handshake (returning users are 0-network). -->
    <link rel="preconnect" href="https://huggingface.co" crossorigin />
    <link rel="dns-prefetch" href="https://huggingface.co" />
    <style>
      /* ──────────────────────────────────────────────────────────────────────────
         Holo Player — a Jellyfin-faithful media library, hologram-native.
         Proportion is golden: spacing is a Fibonacci ramp (≈φ), the type scale steps
         by φ from a 16px floor, the hero is 100vh/φ tall, the detail splits at 1/φ.
         Colours use the OS theme tokens; text never drops below 16px (clean + readable).
         ────────────────────────────────────────────────────────────────────────── */
      :root {
        color-scheme: dark;
        --phi: 1.618;
        /* Fibonacci spacing ramp — consecutive ratios converge on φ. */
        --s1: 8px; --s2: 13px; --s3: 21px; --s4: 34px; --s5: 55px; --s6: 89px; --s7: 144px;
        /* Type scale — ONE ramp, φ½ (≈1.272) steps from the Claude-desktop 14px body; --t0 = meta floor (never
           below 12px). Every font-size in the app is one of these tokens — no raw sizes on chrome. */
        --t0: 12px; --t1: 14px; --t2: 18px; --t3: 23px; --t4: 36px; --t-hero: clamp(2.1rem, 4.4vw, 4.2rem);
        --hero-h: 78vh;                 /* taller, more cinematic — the background trailer carries the top */
        /* Card tiles are FLUID — they scale continuously with the viewport (no fixed breakpoints), floored for
           mobile legibility and capped so they never bloat on 4K. Landscape ≈ portrait × φ for a golden rhythm. */
        --card-w: clamp(7.5rem, 12.5vw, 12.5rem); --card-w-l: clamp(12.5rem, 20.2vw, 20rem);   /* portrait 2:3 · landscape golden φ:1 (width = portrait × 1.618) */
        /* Claude-desktop material (the standing look law): warm-neutral #1f1f1e planes on a #141413 canvas,
           11% hairlines, 10px radii, purple accent. One material language across the whole OS. */
        --rad: 10px; --rad-sm: 7px; --rad-lg: 16px; --top-h: 78px;
        --bg: var(--holo-bg, #141413); --panel: var(--holo-surface, #1f1f1e);
        --line: var(--holo-border, rgba(255, 255, 255, 0.11)); --ink: var(--holo-ink, #f1f1f0);
        --dim: var(--holo-ink-dim, #9b9a94); --acc: var(--holo-accent, #8b5cf6);
        --chip: #262624; --chip-hi: #32322f;
      }
      * { box-sizing: border-box; }
      html, body { height: 100%; margin: 0; }
      body { background: var(--bg); color: var(--ink); overflow: hidden;
        font: var(--t1)/1.5 "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        display: flex; flex-direction: column; -webkit-font-smoothing: antialiased; }
      a { color: inherit; text-decoration: none; }
      button { font: inherit; color: inherit; cursor: pointer; }
      .icon { width: 1.5rem; height: 1.5rem; fill: currentColor; flex: 0 0 auto; }
      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-thumb { background: #2b3139; border-radius: var(--holo-radius-sm, 8px); border: 2px solid var(--bg); }

      /* ── Top chrome — slim, only what's needed ──────────────────────────────── */
      header {
        position: fixed; inset: 0 0 auto 0; height: var(--top-h); z-index: 40;
        display: flex; align-items: center; gap: var(--s4); padding: var(--s3) var(--s5) 0;
        background: linear-gradient(180deg, rgba(8,10,13,0.94), rgba(8,10,13,0));
        transition: background 0.2s;
      }
      header.solid { background: rgba(9,11,14,0.96); border-bottom: 1px solid var(--line); backdrop-filter: blur(12px); }
      /* Keep the bar clean: hide any OS-injected docked buttons (manage/share/etc.). */
      #top > :not(nav):not(.sp):not(.search):not(.brandrow):not(.sidefoot):not(.hero-mute) { display: none !important; }
      /* "H tv" lockup — one quiet row, the Apple-TV top line. */
      .brandrow { display: flex; align-items: center; gap: var(--s2); flex: 0 0 auto; }
      .sidefoot { display: flex; align-items: center; gap: var(--s2); }
      .me-tv { font-weight: 700; font-size: var(--t2); letter-spacing: -0.01em; color: #fff; line-height: 1; }
      /* Nav base — reset only; the ≥900px sidebar and <900px tab bar each own the real look. */
      nav { display: flex; align-items: center; gap: 0.15rem; }
      nav button { background: 0; border: 0; color: var(--dim); font-size: var(--t1); font-weight: 600; padding: var(--s1) var(--s3); border-radius: 999px; position: relative; transition: color 0.15s, background 0.15s; }
      .sp { margin-left: auto; }
      .gear { flex: 0 0 auto; width: var(--s4); height: var(--s4); border-radius: 50%; background: rgba(255,255,255,0.08); border: 0; color: var(--dim); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: color 0.15s, background 0.15s; }
      .gear:hover { color: var(--ink); background: rgba(255,255,255,0.14); }
      .gear .icon { width: 1.3rem; height: 1.3rem; }
      /* Search — the sidebar styles it as a quiet row (≥900px); the mobile top bar as a chip (<900px). */
      .search { display: none; align-items: center; gap: var(--s2); background: var(--chip); border: 1px solid var(--line); border-radius: 999px; padding: 0 var(--s3); height: var(--s4); width: 19rem; max-width: 34vw; transition: border-color 0.2s; }
      .search:focus-within { border-color: var(--acc); }
      .search .icon { width: 1.25rem; height: 1.25rem; color: var(--dim); }
      .search input { flex: 1 1 auto; background: 0; border: 0; outline: 0; color: var(--ink); font: inherit; min-width: 0; }
      .search input::placeholder { color: var(--dim); }
      .search-mic { flex: 0 0 auto; width: 1.7rem; height: 1.7rem; border-radius: 50%; border: 0; background: 0; color: var(--dim); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: color 0.15s, background 0.15s; }
      .search-mic:hover, .search-mic.live { color: var(--acc); background: rgba(255,255,255,0.08); }
      .search-mic .icon { width: 1.05rem; height: 1.05rem; }
      .me { flex: 0 0 auto; padding: 0; overflow: visible; background: transparent; border: 0; cursor: pointer; display: inline-flex; align-items: center; gap: var(--s1); line-height: 0; transition: transform 0.15s ease, filter 0.15s ease; }
      .me svg { display: block; width: 2.3rem; height: 2.3rem; flex: 0 0 auto; }
      .me:hover { transform: scale(1.04); filter: drop-shadow(0 0 6px color-mix(in srgb, var(--acc) 55%, #c79bff)); }

      /* ── Apple-TV LEFT SIDEBAR (desktop ≥900px) — the persistent spine; the immersive stage sits to its
         right and stays mounted. Below 900px the top pill-nav (mobile) is untouched. Tab icons are line-art
         (tvOS grammar); the active row glows in the accent. ── */
      .ti { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; flex: 0 0 auto; shape-rendering: geometricPrecision; }
      nav button .ti { display: none; }
      @media (min-width: 900px) {
        body { flex-direction: row; }
        /* tvOS material — translucent, heavily blurred, faintly TINTED by the featured title's own colour
           (--portal, set by HoloPalette on body) so the chrome breathes with the content. */
        #top { position: static; inset: auto; height: 100vh; width: 16.5rem; flex: 0 0 16.5rem;
          flex-direction: column; align-items: stretch; gap: 2px; padding: var(--s4) var(--s3) var(--s3);
          background: linear-gradient(180deg, color-mix(in srgb, var(--portal, #10131a) 12%, rgba(13,15,20,0.9)), rgba(9,11,14,0.93));
          border-right: 1px solid rgba(255,255,255,0.07); backdrop-filter: blur(28px) saturate(1.4);
          transition: background 0.9s ease; }
        #top.solid { border-bottom: 0; }
        /* Top line: the "H tv" lockup (the Apple-TV sidebar's first row). */
        .brandrow { order: 0; margin: 0 var(--s1) var(--s3); }
        /* Search — a quiet row like every other (Apple-TV pattern): icon tile + a word; it is ALSO the input. */
        .search { order: 1; display: flex; align-items: center; width: 100%; max-width: none; height: auto; background: transparent; border: 0; border-radius: var(--rad); padding: 5px var(--s1) 5px 5px; gap: var(--s2); transition: background 0.14s; }
        .search:hover { background: rgba(255,255,255,0.06); }
        .search:focus-within { background: rgba(255,255,255,0.1); border-color: transparent; }
        .search > .icon { width: 2rem; height: 2rem; padding: 0.4rem; background: rgba(255,255,255,0.1); border-radius: var(--rad); color: #eef1f5; box-shadow: inset 0 0 0 0.5px rgba(255,255,255,0.06); }
        .search input { font-size: var(--t1); font-weight: 600; }
        .search input::placeholder { color: rgba(255,255,255,0.92); }
        .search:focus-within input::placeholder { color: var(--dim); font-weight: 500; }
        nav { order: 2; flex-direction: column; align-items: stretch; gap: 2px; width: 100%; background: transparent; border-radius: 0; padding: 0; }
        /* Rows — icon-in-rounded-tile + label; the active row is a soft white pill whose tile INVERTS to white
           (the tvOS focus grammar). Labels are full white — the tiles carry the hierarchy. */
        nav button { display: flex; align-items: center; justify-content: flex-start; gap: var(--s2); padding: 5px var(--s1) 5px 5px; border-radius: var(--rad); font-size: var(--t1); font-weight: 600; line-height: 1; width: 100%; text-align: left; color: rgba(255,255,255,0.92); transition: color 0.14s, background 0.14s; }
        nav button .ti { display: inline-flex; width: 2rem; height: 2rem; padding: 0.4rem; background: rgba(255,255,255,0.1); border-radius: var(--rad); color: #eef1f5; box-shadow: inset 0 0 0 0.5px rgba(255,255,255,0.06); transition: background 0.14s, color 0.14s; }
        nav button:hover { background: rgba(255,255,255,0.06); }
        nav button.on { color: #fff; background: rgba(255,255,255,0.16); }
        nav button.on .ti { background: #fff; color: #12151b; stroke: #12151b; }
        /* Q — the one BRANDED tile (Apple TV+'s slot): accent gradient, filled sparkle. */
        .nav-q .ti { fill: #fff; stroke: none; color: #fff; background: linear-gradient(135deg, color-mix(in srgb, var(--holo-accent, #8b5cf6) 82%, #4b3fd4), color-mix(in srgb, var(--holo-accent, #8b5cf6) 55%, #c79bff)); }
        nav button.on.nav-q .ti { background: linear-gradient(135deg, color-mix(in srgb, var(--holo-accent, #8b5cf6) 82%, #4b3fd4), color-mix(in srgb, var(--holo-accent, #8b5cf6) 55%, #c79bff)); color: #fff; stroke: none; }
        /* Footer utility tray — pushed to the bottom, quiet; the rail stays pure NAV. */
        .sp { order: 4; margin: auto 0 0; }
        .sidefoot { order: 5; margin: var(--s3) var(--s1) 0; }
        #library, #search { padding-top: var(--s4); }
      }

      main { flex: 1 1 auto; min-height: 0; position: relative; }
      /* Seamless view changes — crossfade + a subtle rise instead of a hard cut. */
      .view { position: absolute; inset: 0; overflow-y: auto; overflow-x: hidden; opacity: 0; transform: translateY(10px); transition: opacity 0.2s ease, transform 0.2s cubic-bezier(.2,.7,.3,1); }
      .view.on { opacity: 1; transform: none; }
      .view[hidden] { display: none !important; }   /* must beat id-level display rules (#guide/#sports/#esports) or hidden views overlay #live and eat scroll */
      @media (prefers-reduced-motion: reduce) { .view { transition: opacity 0.12s ease; transform: none; } }

      /* ── Hero ───────────────────────────────────────────────────────────────── */
      /* overflow:hidden CLIPS the Ken-Burns–scaled backdrop to the hero box, so the
         image never bleeds past the scrim and over the rails. The bottom scrim then
         dissolves it fully into --bg before the first rail begins — no seam. */
      .hero { position: relative; height: var(--hero-h); min-height: 22rem; overflow: hidden; isolation: isolate; }
      .hero .bg { position: absolute; inset: -1px; background: #05070a center/cover no-repeat; animation: kenburns 36s ease-in-out infinite alternate; transform-origin: 50% 36%; will-change: transform; }
      /* Bias the cover-crop UPWARD so faces/subjects are never cut off — the bottom is hidden under the scrim + copy. */
      .hero .bg img.bgimg { object-position: 50% 20%; }
      @keyframes kenburns { from { transform: scale(1.04) translate(0, 0); } to { transform: scale(1.1) translate(-1%, -1%); } }
      .hero .trailer { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; pointer-events: none; opacity: 0; transition: opacity 1.2s ease; }
      .hero .trailer.show { opacity: 1; }
      .hero .trailer iframe { position: absolute; top: 50%; left: 50%; width: 177.78vh; height: 56.25vw; min-width: 100%; min-height: 100%; transform: translate(-50%, -50%); border: 0; }
      .hero .trailer.holo iframe { inset: 0; top: 0; left: 0; width: 100%; height: 100%; transform: none; }   /* Holo Video cover-fills internally */
      /* Detail hero: the trailer autoplays as the background (like the home billboard), cover-filling the 56vh hero. */
      .det-hero .det-trailer { position: absolute; inset: 0; overflow: hidden; opacity: 0; transition: opacity 1s ease; pointer-events: none; z-index: 0; }
      .det-hero .det-trailer.show { opacity: 1; }
      .det-hero .det-trailer iframe { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100vw; height: 56.25vw; min-height: 100%; min-width: 99.6vh; border: 0; }
      .det-hero .scrim { z-index: 1; } .det-hero .back { z-index: 2; }
      /* Ambient "projector light" — the trailer's own colour (HoloPalette --portal) bleeds upward as soft light,
         breathing slowly. Top-anchored so it never touches the title; additive (screen) so it reads as glow. */
      .hero .lumen { position: absolute; left: 0; right: 0; top: 0; height: 52%; z-index: 4; pointer-events: none; mix-blend-mode: screen;
        background: radial-gradient(125% 120% at 50% -12%, color-mix(in srgb, var(--portal, var(--acc)) 62%, transparent), transparent 72%);
        opacity: 0.46; animation: lumen 7.5s ease-in-out infinite; will-change: opacity; }
      @keyframes lumen { 0%, 100% { opacity: 0.38; } 50% { opacity: 0.6; } }
      @media (prefers-reduced-motion: reduce) { .hero .lumen { animation: none; } }
      @media (prefers-reduced-motion: reduce) { .hero .bg { animation: none; } }
      /* Cinematic dissolve: a left-weighted veil for legible copy, plus a bottom ramp
         that reaches solid --bg well before the hero edge so the rails float on clean bg. */
      .hero .scrim { position: absolute; inset: 0;
        background: linear-gradient(90deg, rgba(8,10,13,0.95) 0%, rgba(8,10,13,0.74) 34%, rgba(8,10,13,0.32) 54%, rgba(8,10,13,0) 74%),
                    linear-gradient(0deg, var(--bg) 0%, var(--bg) 7%, rgba(11,13,16,0) 54%); }
      .hero .body { position: absolute; left: var(--s5); bottom: var(--s5); width: min(38rem, 62%); animation: heroIn 0.5s ease both; }
      @keyframes heroIn { from { opacity: 0; transform: translateY(10px); } }
      @media (prefers-reduced-motion: reduce) { .hero .body { animation: none; } }
      /* Pagination dots — low on the billboard so they never cover the video. The active one stretches into a
         pill that glows in the title's own hue; hover gives a gentle lift. Delightful, legible over any frame. */
      .hero-dots { position: absolute; right: var(--s5); bottom: var(--s5); top: auto; transform: none; z-index: 5; display: flex; align-items: center; gap: var(--s2); filter: drop-shadow(0 1px 4px rgba(0,0,0,0.55)); }
      .hero-dots .hd { width: 0.5rem; height: 0.5rem; border-radius: 999px; border: 0; padding: 0; cursor: pointer; background: rgba(255,255,255,0.45);
        transition: width 0.4s cubic-bezier(.2,.7,.3,1), background 0.3s ease, box-shadow 0.3s ease, transform 0.18s ease; }
      .hero-dots .hd:hover { background: rgba(255,255,255,0.85); transform: scale(1.25); }
      .hero-dots .hd.on { background: #fff; width: 1.7rem; box-shadow: 0 0 16px -2px color-mix(in srgb, var(--portal, var(--acc)) 85%, #fff); }
      /* Hero mute toggle — BOTTOM-right (where media controls belong), clear of the fixed header's settings gear;
         fades in on hover. */
      /* Video mute toggle — lives in the header, immediately left of the settings gear, and matches it exactly. */
      .hero-mute { flex: 0 0 auto; width: var(--s4); height: var(--s4); border-radius: 50%; background: rgba(255,255,255,0.08); border: 0; color: var(--dim); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: color 0.15s, background 0.15s; }
      .hero-mute:hover { color: var(--ink); background: rgba(255,255,255,0.14); }
      .hero-mute .icon { width: 1.3rem; height: 1.3rem; }
      /* The hero trailer's mute floats ON the billboard (bottom-right), Apple-TV style — never in the nav rail. */
      .hero .hero-mute { position: absolute; right: var(--s5); bottom: var(--s5); z-index: 9; background: rgba(2,6,12,0.55); backdrop-filter: blur(8px); color: var(--ink); }
      .hero .hero-mute:hover { background: rgba(2,6,12,0.8); }
      /* "Your apps" — circular brand tiles (Google-TV style), springy on hover. */
      /* The 11 tiles spread edge-to-edge across the row and NEVER scroll: a flex row with space-between, and a
         tile diameter that scales with the viewport (clamp) so the set always fits, however wide the window. The
         inner wordmarks/icons are sized in em (relative to the tile), so everything scales together — crisp at any
         size. --ad is the single source of truth for tile size; font-size:var(--ad) makes 1em == one tile. */
      .apps-rail .apps-strip { --ad: clamp(2.1rem, 6.2vw, 4.4rem); display: flex; justify-content: space-between; align-items: center;
        gap: var(--s2); padding: var(--s2) var(--s5) var(--s3); overflow: visible; }
      .app { background: 0; border: 0; cursor: pointer; flex: 0 0 auto; padding: 0; display: inline-flex; }
      .app-ic { position: relative; width: var(--ad); height: var(--ad); font-size: var(--ad); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; overflow: hidden; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08); transition: transform 0.18s cubic-bezier(.2,.7,.3,1), box-shadow 0.18s; }
      .app:hover .app-ic, .app:focus-visible .app-ic { transform: scale(1.1) translateY(-2px); box-shadow: 0 0.8rem 2rem -0.5rem rgba(0,0,0,0.7), inset 0 0 0 1px rgba(255,255,255,0.16); }
      /* Official brand logo (dropped into brands/<slug>.svg) overlays the built-in fallback mark; it stays hidden
         until it actually loads, then fades in — so a missing asset cleanly shows the fallback (no broken image). */
      .brand-logo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 20%; opacity: 0; transition: opacity 0.2s ease; }
      .brand-logo.loaded { opacity: 1; }
      /* Once the official logo has loaded, hide the built-in fallback mark so it can't bleed through the
         transparent SVG (otherwise both layers overlap → a doubled/garbled glyph). */
      .app-ic.has-logo > :not(.brand-logo) { opacity: 0; }
      /* ── Mobile / compact (keyed on VIEWPORT SIZE, never pointer:coarse) ── condensed chrome, content pulled to a
         tighter margin, hero text full-width, hover affordances off (a tap opens detail; see playInline). */
      @media (max-width: 640px) {
        header { padding: var(--s2) var(--s3) 0; gap: var(--s2); }
        .me svg { width: 2rem; height: 2rem; }
        .me-tv { font-size: var(--t2); }
        nav { gap: 0; padding: 0.18rem; max-width: 62vw; overflow-x: auto; scrollbar-width: none; }
        nav::-webkit-scrollbar { display: none; }
        nav button { padding: var(--s1) var(--s2); font-size: var(--t1); }
        .rail h2 { padding: 0 var(--s3); font-size: var(--t1); }
        .strip, .ranked-strip { padding-left: var(--s3); padding-right: var(--s3); }
        /* On phones 11 circular tiles can't all fit — make the row a clean horizontal SWIPE (like the content rails),
           comfortably-sized + snap, instead of squashing/clipping them. */
        .apps-rail .apps-strip { --ad: 3.1rem; justify-content: flex-start; gap: var(--s3); overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; padding-left: var(--s3); padding-right: var(--s3); }
        .apps-rail .apps-strip::-webkit-scrollbar { display: none; }
        .apps-rail .app { scroll-snap-align: start; }
        .hero .body { left: var(--s3); right: var(--s3); width: auto; bottom: var(--s4); }
        .hero .cta .btn { height: 3rem; padding: 0 var(--s4); }
        /* C5 mobile: the Library primary controls collapse from a 210px wrapped stack into ONE horizontal
           scroll row (matching the facet rail below it) — count first, then kind · sort · ready, edge-faded.
           #library specificity so it beats the later base `.lib-bar { flex-wrap: wrap }`. */
        #library .lib-bar { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 1.8rem), transparent); mask-image: linear-gradient(90deg, #000 calc(100% - 1.8rem), transparent); }
        #library .lib-bar::-webkit-scrollbar { display: none; }
        #library .lib-bar > * { flex: 0 0 auto; }
        #libCount { font-size: var(--t2); }
        /* C5 mobile: trim the detail hero so Play + synopsis reach above the fold sooner (#detail beats base 56vh) */
        #detail .det-hero { height: 46vh; min-height: 15rem; }
        #detail .det-body { padding-top: var(--s3); }
      }
      /* ── M6 MOBILE (<900px) — the nav becomes an iOS/tvOS BOTTOM TAB BAR (thumb-native), icon over label,
         active tab in the accent. The top bar stays slim (profile · search · settings). Content clears the bar
         + the home-indicator safe area. Above 900px the desktop sidebar owns nav; this never fires there. ── */
      @media (max-width: 899px) {
